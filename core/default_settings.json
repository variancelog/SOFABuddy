{
  "$schema": "./default_settings.schema.json",
  "schema_version": 1,
  "output": {
    "default": true,
    "folder": ""
  },
  "sofa": {
    "enabled": false,
    "samplerates": [48000],
    "phase_mode": "Original Phase",
    "lf_extension": true,
    "xover": 400.0,
    "uneq": true,
    "dfeq": true,
    "normalize_distance": true,
    "distance_m": 1.5,
    "hrir_length": 512,
    "ild_fix": true,
    "ild_threshold": 1.4,
    "naming": "{filename} {samplerate} {eq}",
    "advanced": {
      "processing_length": 2048,
      "norm_target_db": -1.0,
      "onset_buffer": 32,
      "onset_threshold_ratio": 0.05,
      "blend_low_oct": 0.50,
      "blend_high_oct": 0.75,
      "ild_low_freq": 350.0,
      "ild_high_freq": 3500.0
    }
  },
  "dfhrtf": {
    "enabled": false,
    "per_sofa_lr": true,
    "per_sofa_avg": false,
    "per_sofa_avg_algo": "Soft-DTW",
    "per_sofa_avg_filename": "{filename} avg LR",
    "text_filename": "{filename} {LR}",
    "text_delimiter": "Tab",
    "text_extension": "txt",
    "dfhrtf_graphs": true,
    "weighting_mode": "Auto",
    "weighted_grid": true,
    "weighted_grid_scope": "Per Folder",
    "graph_filename": "{graphtype} {filename}",
    "graph_extension": "png",
    "smoothing": "Variable",
    "tilt": 0.0,
    "extend_lf": false,
    "xover": 400.0,
    "avg_all": false,
    "algo": "Geo-Arc-Length",
    "exclude_outliers": true,
    "avg_filename": "{folder} avg {LR}",
    "avg_graph_filename": "{folder} avg",
    "advanced": {
      "n_fft": 16384,
      "output_octave_fraction": 48,
      "norm_freq_hz": 1000.0,
      "lf_blend_low_oct": 0.50,
      "lf_blend_high_oct": 1.0,
      "stereo_angle_deg": 30.0,

      "weighted_grid_scale_mode": "manual",
      "weighted_grid_scale_low": 0.0001,
      "weighted_grid_scale_high": 0.0025,
      "preserve_lr_balance": true,

      "variable_smoothing_freq_low": 350.0,
      "variable_smoothing_freq_hi": 3000.0,
      "variable_smoothing_n_low": 1.0,
      "variable_smoothing_n_hi": 12.0,
      "variable_smoothing_gamma": 0.88,
      "variable_smoothing_mean_mode": "db"
    }
  },
  "averaging": {
    "num_points": 1024,
    "outlier_threshold_std": 0.85,
    "softdtw_gamma_persofa": 0.06,
    "softdtw_gamma_global": 0.06,
    "softdtw_max_iter": 15,
    "softdtw_tol": 0.0015,
    "geo_arc_y_scale": 0.02
  }
}
