{
  "$schema": "./default_settings.schema.json",
  "schema_version": 1,
  "output": {
    "default": true,
    "folder": ""
  },
  "sofa": {
    "enabled": false,
    "samplerates": [48000],
    "phase_mode": "Original Phase",
    "lf_extension": false,
    "xover": 375.0,
    "uneq": true,
    "dfeq": true,
    "normalize_distance": true,
    "distance_m": 1.2,
    "hrir_length": 512,
    "ild_fix": true,
    "ild_threshold": 1.5,
    "naming": "s_{folder}_{filename}_{samplerate}_{eq}",
    "advanced": {
      "processing_length": 2048,
      "norm_target_db": -1.0,
      "onset_buffer": 32,
      "onset_threshold_ratio": 0.05,
      "blend_low_oct": 0.50,
      "blend_high_oct": 0.75,
      "ild_low_freq": 300.0,
      "ild_high_freq": 6000.0
    }
  },
  "dfhrtf": {
    "enabled": false,
    "per_sofa_lr": true,
    "per_sofa_avg": false,
    "per_sofa_avg_algo": "Soft-DTW",
    "text_filename": "t_{folder}_{filename}_{LR}",
    "text_delimiter": "Tab",
    "text_extension": "txt",
    "dfhrtf_graphs": true,
    "weighting_mode": "Auto",
    "weighted_grid": true,
    "weighted_grid_scope": "Per Folder",
    "graph_filename": "g_{folder}_{filename}_{graphtype}_LR",
    "graph_extension": "png",
    "smoothing": 24,
    "tilt": 0.0,
    "extend_lf": false,
    "xover": 375.0,
    "avg_all": false,
    "algo": "Soft-DTW",
    "exclude_outliers": true,
    "advanced": {
      "n_fft": 16384,
      "output_octave_fraction": 48,
      "norm_freq_hz": 1000.0,
      "lf_blend_low_oct": 0.50,
      "lf_blend_high_oct": 1.0,
      "stereo_angle_deg": 30.0,

      "weighted_grid_scale_mode": "manual",
      "weighted_grid_scale_low": 0.0001,
      "weighted_grid_scale_high": 0.0025,
      "preserve_lr_balance": true
    }
  },
  "averaging": {
    "num_points": 512,
    "outlier_threshold_std": 1.0,
    "outlier_gamma": 1.0,
    "softdtw_gamma_persofa": 0.01,
    "softdtw_gamma_global": 0.03,
    "softdtw_max_iter": 25,
    "softdtw_tol": 0.001,
    "geo_arc_y_scale": 0.01
  }
}
